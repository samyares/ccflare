[Unit]
Description=ccflare multi-provider AI proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ccflare
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PORT=8080
Environment=LOG_LEVEL=INFO
ExecStart=/root/.bun/bin/bun run apps/server/src/server.ts
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
