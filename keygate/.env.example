# keygate configuration (copy to /root/keygate/.env)
ADMIN_KEY=sk-admin-CHANGE-ME          # openssl rand -hex 16
GATE_PORT=4000                        # public proxy + usage dashboard
ADMIN_PORT=8081                       # basic-auth pass-through to the ccflare dashboard
UPSTREAM=http://127.0.0.1:8080        # ccflare
KEYS_FILE=/root/keygate/keys.json
CCFLARE_DB=/root/.config/ccflare/ccflare.db
DASHBOARD_FILE=/root/keygate/dashboard.html
LIMITS_FILE=/root/keygate/limits.json
